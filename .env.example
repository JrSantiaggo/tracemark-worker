NODE_ENV=development
LOG_LEVEL=info

AWS_REGION=us-east-1
SQS_QUEUE_URL=http://localhost:9324/000000000000/tracemark-photo-processing
SQS_ENDPOINT=http://localhost:9324

S3_BUCKET=tracemark-photos-local
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=mesma-chave-do-emulador-da-api
AWS_SECRET_ACCESS_KEY=mesmo-segredo-do-emulador-da-api

API_BASE_URL=http://localhost:3333
INTERNAL_API_TOKEN=mesmo-valor-do-INTERNAL_API_TOKEN-da-api

WORKER_CONCURRENCY=2
MAX_RECEIVE_COUNT=3
SQS_WAIT_TIME_SECONDS=20
HEALTH_PORT=8080
PREVIEW_MAX_DIMENSION=1600
PREVIEW_JPEG_QUALITY=80
WATERMARK_TEXT=TraceMark
